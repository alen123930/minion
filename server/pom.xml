<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.legion</groupId>
        <artifactId>legion-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>legion-server</artifactId>
    <packaging>jar</packaging>
    <name>legion-server</name>
    <description>legion server：Spring Boot API（WebMvc；SSE/WS + MyBatis + Flyway 由后续任务按需引入）</description>

    <dependencies>
        <!-- WebMvc 是模块身份（否决 WebFlux，AGENTS.md）；其余业务依赖按需后补 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- M0-4：MyBatis XML mapper（SQL 原文进 review，版本由父 POM dependencyManagement 锁定） -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.legion</groupId>
            <artifactId>legion-contracts</artifactId>
        </dependency>
        <!-- M0-5：daemon 以库形式内嵌启动（设计 §二），worker 对 server 的所有调用走 localhost HTTP -->
        <dependency>
            <groupId>io.legion</groupId>
            <artifactId>legion-daemon</artifactId>
        </dependency>
        <!-- M0-3：Flyway 迁移 + JDBC 数据源 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Boot 3.5 起 PG 支持拆分到独立构件，缺它 Flyway 报 "Unsupported Database" -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 集成测试基线：真实 PG17 容器验证迁移与约束（AGENTS.md：mvn test 需 docker） -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- M0-4：@ServiceConnection 把 Testcontainers 容器接进 Spring 上下文（M0-3 测试注释预留给本任务） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>