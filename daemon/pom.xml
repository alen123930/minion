<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.legion</groupId>
        <artifactId>legion-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>legion-daemon</artifactId>
    <packaging>jar</packaging>
    <name>legion-daemon</name>
    <description>legion daemon：Spring Boot 应用，无 web 容器仅 actuator（loop/ env/ agent/ 由后续任务引入）</description>

    <dependencies>
        <!-- 设计 §二：daemon 无 web 容器，仅 actuator；loop/env/agent 是业务依赖，按需后补 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- M0-5：daemon↔server 协议 DTO + HTTP client 的 JSON 编解码（JDK HttpClient，零 web 容器） -->
        <dependency>
            <groupId>io.legion</groupId>
            <artifactId>legion-contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- OffsetDateTime（created_at）反序列化需要 jsr310 模块 -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- NIMI-18：daemon 被 server 以库依赖内嵌（设计 §二），但 repackage 默认用 fat-jar
                     替换主构件——reactor 内 server 解析到的就是 BOOT-INF/classes 嵌套布局的 fat-jar，
                     javac 找不到 io.legion.daemon.*，`mvn -pl server -am package` 必挂（fat-jar 根路径
                     零个 io/legion 条目已实测）。classifier=exec 让可执行 jar 改挂 -exec 附构件，
                     薄 jar 回归主构件：server 依赖解析与独立 fat-jar 两全（Spring Boot 插件文档
                     "repackaged archive as a dependency" 的标准处置）。 -->
                <configuration>
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
